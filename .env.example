# Copy to .env and adjust the values before `docker compose up -d`.

# Required: a long random Redis password, e.g. `openssl rand -base64 32`.
REDIS_PASSWORD=change-me-to-a-long-random-value

# Public origin used for share links and QR codes. No trailing slash.
ONLINEPASTE_BASE_URL=http://localhost:8080

# Host port published by the app container.
APP_PORT=8080

# Maximum paste size in characters.
ONLINEPASTE_MAX_CONTENT_LENGTH=100000

# Write requests allowed per client IP per minute.
ONLINEPASTE_RATE_LIMIT_PER_MINUTE=30

# Container timezone.
TZ=UTC
